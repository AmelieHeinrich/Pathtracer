# pathtracer scene v1
#
# Coloured glass on a table, lit through a window.
#
#   Pathtracer --scene scenes/still_life.pts --sky 0 --bounces 14 --samples 4096 \
#              --capture still_life.png
#
# Three bottles, a paperweight and a teapot, on polished wood, in a dark room with one tall
# emissive slab off to the left standing in for a window. The light rakes across the table
# rather than coming down on it, so each piece of glass throws its colour a long way toward
# the camera instead of pooling underneath itself.
#
# What the scene is for: absorption is not a surface tint, and coloured caustics are the
# proof. The green bottle is not green because its albedo is green -- its albedo is white.
# Light that crosses it comes out green, so the bottle is green, the shadow it casts is green,
# and the bright caustic inside that shadow is the most saturated green in the frame. The
# clear sphere next to them throws the one white caustic, which is what makes the other three
# read as coloured rather than just dim.
#
# absorption_distance is small here -- 0.3 to 0.35 against bottles about 0.6 across -- because
# it has to be tuned to the size of the object. The same colours at the default distance of 1
# would leave these looking like faintly tinted water.
#
# The window is an emissive instance, not an area light, because only an emissive instance can
# be found by a bounce ray, and a caustic is a bounce ray: table, into the glass, out of the
# glass, into the window. An area light here would give a nicely lit table and no caustics at
# all.
#
# The bottles are solid glass, not hollow. Absorption tracks one medium at a time, so a bottle
# with an air cavity inside it -- or a wine level, or a stopper made of separate glass -- gets
# the boundaries wrong. Keep transmissive things apart.

camera
  position 1.35 1.15 4.7
  yaw 191
  pitch -9
  fov 40
  aperture 0.015
  focus_distance 4.6

entity "table"
  shape       cube
  translation 0 -0.1 0
  rotation    0 0 0
  scale       4 0.1 3
  albedo      0.35 0.19 0.09
  roughness   0.3

entity "back wall"
  shape       cube
  translation 0 2 -3.2
  rotation    0 0 0
  scale       5 2 0.1
  albedo      0.07 0.065 0.06
  roughness   0.95

entity "right wall"
  shape       cube
  translation 4.5 2 0
  rotation    0 0 0
  scale       0.1 2 3.2
  albedo      0.07 0.065 0.06
  roughness   0.95

entity "green bottle"
  shape        cylinder
  translation  -0.9 1 -0.4
  rotation     0 0 0
  scale        0.3 1 0.3
  albedo       1 1 1
  roughness    0
  transmission 1
  ior          1.52
  absorption   0.16 0.62 0.34
  absorption_distance 0.35

entity "amber bottle"
  shape        cylinder
  translation  -0.15 0.75 0.1
  rotation     0 0 0
  scale        0.28 0.75 0.28
  albedo       1 1 1
  roughness    0
  transmission 1
  ior          1.55
  absorption   0.85 0.45 0.1
  absorption_distance 0.35

# Shorter and wider than the other two, so the light crosses more of it and it goes darkest at
# the middle -- the thickness dependence that separates absorption from a surface colour.
entity "wine"
  shape        cylinder
  translation  0.75 0.45 -0.55
  rotation     0 0 0
  scale        0.4 0.45 0.4
  albedo       1 1 1
  roughness    0
  transmission 1
  ior          1.35
  absorption   0.55 0.06 0.12
  absorption_distance 0.3

# Clear, and the brightest thing on the table. The white caustic it throws is the reference
# the coloured ones are read against.
entity "paperweight"
  shape        sphere
  translation  1.55 0.3 0.45
  rotation     0 0 0
  scale        0.3 0.3 0.3
  albedo       1 1 1
  roughness    0
  transmission 1
  ior          1.52

# The opaque anchor. Polished ceramic is a dielectric with a tight specular layer over a
# near-white base, so it catches the window as one hard highlight and stays matte elsewhere --
# the thing all the glass is not.
entity "teapot"
  shape       teapot
  translation -1.95 0.441 0.55
  rotation    0 40 0
  scale       0.9 0.9 0.9
  albedo      0.9 0.89 0.86
  roughness   0.05

# Tall, narrow, and just outside the left edge of frame. Its long axis is vertical so the
# light stays directional across the table instead of wrapping around everything.
entity "window"
  shape             cube
  translation       -4.2 2.6 1
  rotation          0 0 0
  scale             0.06 1.6 1.1
  albedo            0 0 0
  emission          1 0.95 0.85
  emission_strength 8
  roughness         1
